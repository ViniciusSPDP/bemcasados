# Copie para .env e preencha. Nunca versione o .env — ele está no .gitignore.

# ---------- Banco de dados ----------
DATABASE_URL="postgresql://usuario:senha@localhost:5433/bem_casados_db?schema=public"

# ---------- Autenticação (NextAuth v5) ----------
# Gere com: openssl rand -base64 48
AUTH_SECRET=""
# URL pública da aplicação. Sem isso, atrás do Traefik/Cloudflare o callback de
# login aponta para https://localhost:80 e o fluxo quebra.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ---------- Gateway de pagamento (Asaas) ----------
# Sandbox: https://api-sandbox.asaas.com/v3 | Produção: https://api.asaas.com/v3
ASAAS_URL="https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY=""
# Token do header `asaas-access-token` do webhook. Gere com: openssl rand -hex 32
ASAAS_WEBHOOK_TOKEN=""

# ---------- Armazenamento de imagens (S3 / MinIO) ----------
# O bucket deve ser PRIVADO: as imagens são servidas por /api/media/<chave>.
S3_ENDPOINT="http://localhost:9002"
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="bem-casados-bucket"

# ---------- Rate limiting ----------
# Sem esta variável o rate limiting fica desativado (a aplicação sobe, mas
# checkout e login ficam sem freio). Obrigatória em produção.
REDIS_URL="redis://localhost:6379"

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- Seed (opcional, só para popular o ambiente) ----------
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ---------- docker-compose local ----------
POSTGRES_USER="bemcasados"
POSTGRES_PASSWORD=""
POSTGRES_DB="bem_casados_db"
MINIO_ROOT_USER="bemcasados"
MINIO_ROOT_PASSWORD=""
