generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

//Modelo do Usuario
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  events    Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Modelo do casamento
model Event {
  id         String   @id @default(uuid())
  slug       String   @unique
  title      String
  coupleName String
  eventDate  DateTime
  pixKey       String?

  //Story
  galleryItems   GalleryItem[]
  videoUrl String?
  introTitle String @default("VOCÊ FOI CONVOCADO")
  introSubtitle String @default("PARA UMA MISSÃO ESPECIAL")
  welcomeMessage String? @db.Text

  isApproved Boolean @default(false)
  asaasApiKey String?
  walletId    String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gifts       Gift[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

//Presentes do casamento
model Gift {
  id          String  @id @default(uuid())
  title       String
  description String?
  price       Decimal @db.Decimal(10, 2)
  imageUrl    String?
  category    String?
  available   Boolean @default(true)
  isExclusive Boolean  @default(true)

  //Relacionamento com o evento
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])
  
  transactions Transaction[]
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//Transações Financeiras
model Transaction {
  id String @id @default(uuid())

  //Relacionameto com o presente
  giftId String
  gift   Gift   @relation(fields: [giftId], references: [id])

  //Dados do Convidado
  guestName  String
  guestEmail String
  guestCPF   String
  message    String? @db.Text

  //Valores Financeiros
  amountOriginal Decimal @db.Decimal(10, 2)
  amountCharged  Decimal @db.Decimal(10, 2)
  feeAmount      Decimal @db.Decimal(10, 2)

  //Asaas
  asaasId       String? @unique
  paymentLink   String?
  status        String  @default("PENDING")
  paymentMethod String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryItem {
  id        String   @id @default(cuid())
  imageUrl  String
  caption   String?  
  
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  orderIndex Int @default(0) 
}